<FindBugsFilter>
    <!-- Generated gRPC client code -->
    <Match>
        <Package name="io.ballerina.observe.choreo.gen"/>
    </Match>

    <!-- False positives when Files.newOutputStream is used -->
    <Match>
        <Class name="io.ballerina.observe.choreo.client.internal.secret.AnonymousAppSecretHandler"/>
        <Or>
            <Method name="readStoredObsId"/>
            <Method name="persistSecret"/>
        </Or>
        <Bug pattern="RCN_REDUNDANT_NULLCHECK_OF_NONNULL_VALUE"/>
    </Match>
    <Match>
        <Class name="io.ballerina.observe.choreo.client.ChoreoSpanExporter$Task"/>
        <Method name="run"/>
        <Bug pattern="DMI_RANDOM_USED_ONLY_ONCE"/>
    </Match>
    <Match>
        <Class name="io.ballerina.observe.choreo.client.error.ChoreoError"/>
        <Method name="getCause"/>
        <Bug pattern="EI_EXPOSE_REP"/>
    </Match>
    <Match>
        <Class name="io.ballerina.observe.choreo.client.error.ChoreoError"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <Match>
        <Class name="io.ballerina.observe.choreo.client.model.ChoreoMetric"/>
        <Method name="getTags"/>
        <Bug pattern="EI_EXPOSE_REP"/>
    </Match>
    <Match>
        <Class name="io.ballerina.observe.choreo.client.model.ChoreoMetric"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <Match>
        <Class name="io.ballerina.observe.choreo.client.model.ChoreoTraceSpan"/>
        <Bug pattern="EI_EXPOSE_REP, EI_EXPOSE_REP2"/>
    </Match>

    <!-- SpotBugs 6.5.1 newly flags these constructors as vulnerable to finalizer attacks (CT_CONSTRUCTOR_THROW).
         None have finalizers or are designed for subclassing; each throws to legitimately fail-fast on a real
         initialization error (a required resource/client not being available), not a framework requirement. -->
    <Match>
        <Class name="io.ballerina.observe.choreo.BallerinaMetadataReader"/>
        <Bug pattern="CT_CONSTRUCTOR_THROW"/>
    </Match>
    <Match>
        <Class name="io.ballerina.observe.choreo.client.ChoreoSpanExporter"/>
        <Bug pattern="CT_CONSTRUCTOR_THROW"/>
    </Match>
    <Match>
        <Class name="io.ballerina.observe.choreo.client.internal.secret.AnonymousAppSecretHandler"/>
        <Bug pattern="CT_CONSTRUCTOR_THROW"/>
    </Match>
</FindBugsFilter>
