<FindBugsFilter>
    <!-- SpotBugs 6.5.1 (bumped from 5.0.14 as part of the Gradle 9.5.1 migration) newly flags these
         test-support methods for declaring `throws Exception` instead of a narrower checked exception.
         Pre-existing test helper style, not a behavioral issue; narrowing it would require touching
         call sites across the whole test suite, out of scope for this migration. -->
    <Match>
        <Class name="~.*\.(BaseTestCase|GeneralExtensionTestCase|InitializationErrorTestCase|PeriscopeErrorTestCase|SuccessfulStartBaseTestCase)"/>
        <Bug pattern="THROWS_METHOD_THROWS_CLAUSE_BASIC_EXCEPTION"/>
    </Match>

    <!-- Same EI_EXPOSE_REP/REP2 category already suppressed for production code in
         choreo-extension-native/spotbugs-exclude.xml. These are plain JSON (de)serialization
         POJOs in the test-recording harness (request/response wire models) — returning/storing
         the backing list directly is the intended behavior, not a real encapsulation bug. -->
    <Match>
        <Package name="io.ballerina.observe.choreo.recording"/>
        <Bug pattern="EI_EXPOSE_REP, EI_EXPOSE_REP2"/>
    </Match>

    <!-- BaseTestCase.initializeSuite() is a TestNG @BeforeSuite hook that legitimately
         initializes the shared static test-server handle once per suite run. -->
    <Match>
        <Class name="~.*\.BaseTestCase"/>
        <Bug pattern="ST_WRITE_TO_STATIC_FROM_INSTANCE_METHOD"/>
    </Match>
</FindBugsFilter>
